# Supabase direct connection for local development and Prisma Migrate.
# Replace [PASSWORD] with the database password from Supabase Connect.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.cwbewsezobxefteozrky.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.cwbewsezobxefteozrky.supabase.co:5432/postgres?schema=public"

# For local PostgreSQL development, replace both URLs with:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/project_quizz?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/project_quizz?schema=public"

# For serverless deployments, use Supabase's Transaction pooler URL (port 6543)
# for DATABASE_URL and keep a direct/session connection for DIRECT_URL.
# Add pgbouncer=true to the transaction pooler URL.
