generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  teacher
  student
  parent

  @@map("user_role")
}

enum AssignmentStatus {
  draft
  published
  archived
  revoked

  @@map("assignment_status")
}

enum GuardianStatus {
  pending
  verified
  revoked

  @@map("guardian_status")
}

model User {
  id            String    @id
  role          UserRole
  name          String
  email         String?
  phone         String?
  externalCode  String?   @map("external_code")
  publicCode    String?   @unique @map("public_code")
  loginCodeHash String?   @map("login_code_hash")
  active        Boolean   @default(true)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lockReason    String?   @map("lock_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  legacyData    Json?     @map("legacy_data")

  memberships            ClassStudent[]
  teacherAssignments     ClassTeacherAssignment[]
  guardianLinksAsParent  StudentGuardianLink[]    @relation("GuardianParent")
  guardianLinksAsStudent StudentGuardianLink[]    @relation("GuardianStudent")
  ownedQuizzes           Quiz[]                   @relation("QuizOwner")
  createdVersions        QuizVersion[]            @relation("VersionCreator")
  publishedAssignments   QuizAssignment[]         @relation("AssignmentCreator")
  submissions            Submission[]
  auditEntries           AuditLog[]               @relation("AuditActor")

  @@index([role, active])
  @@index([externalCode])
  @@map("users")
}

model SchoolClass {
  id           String   @id
  name         String
  code         String?  @unique
  grade        String?
  academicYear String?  @map("academic_year")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  legacyData   Json?    @map("legacy_data")

  students    ClassStudent[]
  teachers    ClassTeacherAssignment[]
  assignments QuizAssignment[]
  layouts     ClassroomLayout[]

  @@map("classes")
}

model Subject {
  id        String   @id
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  teacherAssignments ClassTeacherAssignment[]
  quizzes            Quiz[]
  versions           QuizVersion[]
  assignments        QuizAssignment[]

  @@map("subjects")
}

model ClassStudent {
  id         String    @id
  classId    String    @map("class_id")
  studentId  String    @map("student_id")
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt     DateTime? @map("left_at") @db.Timestamptz(3)
  legacyData Json?     @map("legacy_data")

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, joinedAt])
  @@index([studentId, leftAt])
  @@map("class_students")
}

model ClassTeacherAssignment {
  id         String    @id
  classId    String    @map("class_id")
  teacherId  String    @map("teacher_id")
  subjectId  String?   @map("subject_id")
  role       String    @default("subject_teacher")
  status     String    @default("active")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  legacyData Json?     @map("legacy_data")

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([teacherId, status])
  @@index([classId, subjectId, status])
  @@map("class_teacher_assignments")
}

model StudentGuardianLink {
  id           String         @id
  parentId     String         @map("parent_id")
  studentId    String         @map("student_id")
  relationship String         @default("guardian")
  status       GuardianStatus @default(pending)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt   DateTime?      @map("verified_at") @db.Timestamptz(3)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(3)
  legacyData   Json?          @map("legacy_data")

  parent  User @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId, status, revokedAt])
  @@index([studentId, status])
  @@map("student_guardians")
}

model Quiz {
  id                String   @id
  title             String
  description       String   @default("")
  subjectId         String?  @map("subject_id")
  ownerId           String?  @map("owner_id")
  originalCreatorId String?  @map("original_creator_id")
  status            String   @default("active")
  currentVersion    Int      @default(1) @map("current_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  legacyData        Json?    @map("legacy_data")

  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  owner       User?            @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions    QuizVersion[]
  assignments QuizAssignment[]

  @@index([ownerId, status])
  @@index([subjectId])
  @@map("quizzes")
}

model QuizVersion {
  id         String   @id
  quizId     String   @map("quiz_id")
  version    Int
  title      String
  subjectId  String?  @map("subject_id")
  questions  Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by")
  legacyData Json?    @map("legacy_data")

  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  subject     Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  creator     User?            @relation("VersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments QuizAssignment[]
  submissions Submission[]

  @@unique([quizId, version])
  @@index([subjectId])
  @@index([createdBy])
  @@map("quiz_versions")
}

model QuizAssignment {
  id              String           @id
  quizId          String           @map("quiz_id")
  quizVersionId   String           @map("quiz_version_id")
  classId         String           @map("class_id")
  subjectId       String?          @map("subject_id")
  assignedBy      String?          @map("assigned_by")
  title           String
  dueAt           DateTime?        @map("due_at") @db.Timestamptz(3)
  durationMinutes Int?             @map("duration_minutes")
  allowLate       Boolean          @default(true) @map("allow_late")
  status          AssignmentStatus @default(published)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  legacyData      Json?            @map("legacy_data")

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  version     QuizVersion  @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  class       SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  creator     User?        @relation("AssignmentCreator", fields: [assignedBy], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([classId, status, dueAt])
  @@index([quizId])
  @@index([quizVersionId])
  @@index([subjectId])
  @@index([assignedBy])
  @@map("quiz_assignments")
}

model Submission {
  id            String    @id
  assignmentId  String    @map("assignment_id")
  quizVersionId String    @map("quiz_version_id")
  studentId     String    @map("student_id")
  answers       Json      @default("{}")
  score         Float?
  total         Float?
  status        String    @default("submitted")
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(3)
  legacyData    Json?     @map("legacy_data")

  assignment QuizAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  version    QuizVersion    @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  student    User           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@index([assignmentId, status])
  @@index([quizVersionId])
  @@map("submissions")
}

model ClassroomLayout {
  id         String   @id
  classId    String   @map("class_id")
  name       String
  term       String?
  layout     Json     @default("{}")
  isShared   Boolean  @default(true) @map("is_shared")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  legacyData Json?    @map("legacy_data")

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, term])
  @@map("classroom_layouts")
}

model AuditLog {
  id        String   @id
  actorId   String?  @map("actor_id")
  action    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
